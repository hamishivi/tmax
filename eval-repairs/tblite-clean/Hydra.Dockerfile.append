
# Cache the exact upstream plugin for offline agent and verifier installation.
RUN git clone --bare --single-branch --branch v1.3.0 \
      https://github.com/facebookresearch/hydra.git /opt/hydra-mirror.git \
    && test "$(git --git-dir=/opt/hydra-mirror.git rev-parse 'v1.3.0^{commit}')" = \
       273ce9c6e1bd54cfb0b594a4a924a4d3c9b5425f
RUN pip install --no-cache-dir uv==0.7.13 \
    && mkdir /opt/wheelhouse \
    && pip download -d /opt/wheelhouse \
       setuptools==84.0.0 wheel==0.48.0 read-version==0.3.2 \
       hydra-core==1.3.0 submitit==1.5.4 pytest==8.4.1 \
    && pip wheel --no-deps -w /opt/wheelhouse \
       'git+file:///opt/hydra-mirror.git@v1.3.0#subdirectory=plugins/hydra_submitit_launcher' \
    && sha256sum /opt/wheelhouse/* > /opt/wheelhouse.sha256
RUN git config --system url."/opt/hydra-mirror.git".insteadOf \
      https://github.com/facebookresearch/hydra.git \
    && printf '[global]\nno-index = true\nfind-links = /opt/wheelhouse\n' > /etc/pip.conf
