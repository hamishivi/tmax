+def test_quote_heavy_command_avoids_outer_argument_expansion(monkeypatch):
+    import shlex
+    import shutil
+    import uuid
+    from pathlib import Path
+
+    if shutil.which("setsid") is None:
+        pytest.skip("requires Linux setsid")
+    inst = _disk_apptainer_instance("sandfleet-long-" + uuid.uuid4().hex[:8])
+    command_id = "long-quotes"
+    command = ": #" + "x" * 54000 + "'" * 6000 + '\nprintf "%s" "$0"; exit 7'
+    # Include Harbor's cwd/subshell layer, not only a direct worker call.
+    command = "cd -- /tmp && " + shlex.join(["bash", "-c", command])
+    wrapped = "bash -c " + shlex.quote(command)
+    assert len(inst._wrap_for_in_instance_cancel(command_id, wrapped).encode()) > 131072
+    captured = []
+
+    def real_exec(argv, **kwargs):
+        captured.append(argv)
+        return subprocess.run(argv, input=b"", capture_output=True, timeout=10)
+
+    monkeypatch.setattr(inst, "exec", real_exec)
+    try:
+        result = inst.run_command(
+            command, 10, command_id=command_id, worker_deadline=True
+        )
+        assert result["exit_code"] == 7
+        assert result["stdout"] == "bash"
+        assert max(len(arg.encode()) for arg in captured[0]) < 131072
+    finally:
+        for suffix in ("", ".tmp", ".stop"):
+            Path(inst._command_pidfile(command_id) + suffix).unlink(missing_ok=True)
